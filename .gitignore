# runs and tests stay on your computer, except what others need to study a run:
# its log, cost, notes, each skill's summary, the jury's report and the panels
/competition/proposals/**
!/competition/proposals/**/
!/competition/proposals/*/log.md
!/competition/proposals/*/cost.csv
!/competition/proposals/*/usage.csv
!/competition/proposals/*/README.md
!/competition/proposals/*/version.md
!/competition/proposals/*/*/summary.md
!/competition/proposals/*/jury/report.md
!/competition/proposals/*/panel-layout/panel-*.png
/competition/proposals/test/
/competition/proposals/preview/
/proposals/
.env
node_modules/
__pycache__/
.DS_Store

# made by pdf-to-md: big, and anyone can remake them. Only the plans' PNGs are kept.
/competition/brief/*-images/
/competition/brief/*-drawings/*.pdf
/competition/brief/*-drawings/*.svg

# made once per site by climate; anyone can remake it
/competition/climate/

# the Europan 18 winners, references for the runs: other people's work, so they stay off the public repo (zip on Moodle)
/competition/references/winners/

# mockups from brainstorming sessions
/.superpowers/
